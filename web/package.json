{
  "name": "loto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:codeserver": "VITE_DEV_PROFILE=codeserver vite dev --host 0.0.0.0",
    "build": "vite build",
    "build:gh": "BUILD_PROFILE=gh vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "lint": "eslint .",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "verify:pwa": "node scripts/verify-pwa-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@sveltejs/adapter-static": "^4",
    "@sveltejs/kit": "^3",
    "@sveltejs/vite-plugin-svelte": "^7",
    "@tailwindcss/vite": "^4",
    "eslint": "^10",
    "eslint-plugin-svelte": "^3",
    "globals": "^17",
    "happy-dom": "20.11.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1",
    "vitest": "^4.1.11"
  }
}
