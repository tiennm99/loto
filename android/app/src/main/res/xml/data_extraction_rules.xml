<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+ backup/transfer rules (L9). The round-state DataStore
    (`loto_game_state`, written by GameStateRepository via the
    `gameStateDataStore` delegate in LotoApplication.kt) is device-local and
    transient — a fairground round restored mid-game on another device is
    confusing, not useful. The settings DataStore (`loto_settings`) is
    intentionally NOT excluded here: those preferences are worth carrying
    over on cloud restore and device-to-device transfer.

    On-disk path verified from androidx.datastore.preferences.preferencesDataStore's
    default file location: files/datastore/<name>.preferences_pb. DataStore
    writes through a `.tmp` sibling of that same name before the atomic
    rename; a backup taken mid-write can capture that sibling instead of (or
    alongside) the final file, so it is excluded too.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/loto_game_state.preferences_pb" />
        <exclude domain="file" path="datastore/loto_game_state.preferences_pb.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/loto_game_state.preferences_pb" />
        <exclude domain="file" path="datastore/loto_game_state.preferences_pb.tmp" />
    </device-transfer>
</data-extraction-rules>
