<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: the brand's rose → amber → rose diagonal, matching
  the gradient in web/static/icons/source.svg. Replaces the Android Studio
  template's teal grid.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FFF43F5E" />
                <item android:offset="0.5" android:color="#FFF59E0B" />
                <item android:offset="1.0" android:color="#FFF43F5E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
